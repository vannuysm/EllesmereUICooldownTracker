package-as: EllesmereUICooldownTracker

ignore:
    - .gitignore
    - .pkgmeta
    - .gitattributes
    - README.md
    - *.log
    - .github
    - Logo.png
    - tests
    - local
    - pyproject.toml
    - uv.lock
    - .python-version
    - .venv
    - .uv-cache
    - .pytest_cache
    - test-results
    - .env*
    - .release
    - scripts
