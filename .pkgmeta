package-as: EllesmereUICooldownTracker

# Sources include the package name; destinations are relative to the zip root.
move-folders:
    EllesmereUICooldownTracker/src: EllesmereUICooldownTracker

ignore:
    - .gitignore
    - .pkgmeta
    - .gitattributes
    - src/.luarc.json
    - *.code-workspace
    - README.md
    - *.log
    - .github
    - Logo.png
    - tests
    - local
    - pyproject.toml
    - uv.lock
    - .python-version
    - .venv
    - .uv-cache
    - .pytest_cache
    - test-results
    - .env*
    - .release
    - scripts
