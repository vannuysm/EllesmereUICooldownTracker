{
    // src/ and tests/ are sibling folders so the Lua language server checks each with its
    // own .luarc.json (WoW for src/, standard Lua 5.1 for tests/) and neither sees the
    // other's globals.
    "folders": [
        {
            "name": "EllesmereUICooldownTracker",
            "path": "."
        },
        {
            "name": "EllesmereUICooldownTrackerSource",
            "path": "src"
        },
        {
            "name": "EllesmereUICooldownTrackerTests",
            "path": "tests"
        }
    ],
    "settings": {
        "Lua.runtime.version": "Lua 5.1",
        "Lua.runtime.builtin": {
            "basic": "disable",
            "debug": "disable",
            "io": "disable",
            "math": "disable",
            "os": "disable",
            "package": "disable",
            "string": "disable",
            "table": "disable",
            "utf8": "disable"
        },
        "Lua.workspace.library": [
            "~\\.vscode\\extensions\\ketho.wow-api-0.22.3\\Annotations\\Core"
        ]
    }
}